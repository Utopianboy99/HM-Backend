Base URL: http://localhost:3000

# Start the application
1. Create a `.env` file in the project root with your MongoDB URI:

   MONGODB_URI="your-mongodb-connection-string"

2. Install dependencies:

   npm install

3. Start the server:

   node server.js

4. Open the API in your browser or via cURL:

   http://localhost:3000/

# cURL command examples

## Health check
curl -X GET "http://localhost:3000/health"

## Auth Endpoints (Public)

### Sign up
curl -X POST "http://localhost:3000/auth/signup" \
  -H "Content-Type: application/json" \
  -d '{
    "email": "john@example.com",
    "password": "SecurePass123!",
    "full_name": "John Doe",
    "role": "freelancer",
    "phone": "+27821234567"
  }'

### Sign in
curl -X POST "http://localhost:3000/auth/signin" \
  -H "Content-Type: application/json" \
  -d '{
    "email": "john@example.com",
    "password": "SecurePass123!"
  }'

# After signin, you'll get a customToken. Use Firebase SDK to exchange it:
# const userCredential = await signInWithCustomToken(auth, customToken);
# const idToken = await userCredential.user.getIdToken();
# Then use this idToken in Authorization header for protected endpoints

## Users (Protected - requires Bearer token)

### Get all users
curl -X GET "http://localhost:3000/users" \
  -H "Authorization: Bearer YOUR_ID_TOKEN_HERE"

### Get specific user
curl -X GET "http://localhost:3000/users/user-uuid" \
  -H "Authorization: Bearer YOUR_ID_TOKEN_HERE"

### Create user (direct - for admin only)
curl -X POST "http://localhost:3000/users" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_ID_TOKEN_HERE" \
  -d '{
    "email": "alice@example.com",
    "full_name": "Alice Dlamini",
    "role": "freelancer",
    "phone": "+27821234567",
    "profile_photo_url": "https://example.com/photos/alice.jpg",
    "bio": "Full-stack developer with 5 years of experience.",
    "skills": ["JavaScript", "Node.js", "React"],
    "location_city": "Johannesburg",
    "location_country": "South Africa",
    "lat": -26.2041,
    "lng": 28.0473
  }'

### Update user
curl -X PUT "http://localhost:3000/users/user-uuid" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_ID_TOKEN_HERE" \
  -d '{
    "full_name": "Alice Updated",
    "bio": "Updated developer profile.",
    "skills": ["JavaScript", "Node.js", "React", "Python"]
  }'

### Delete user (soft delete)
curl -X DELETE "http://localhost:3000/users/user-uuid" \
  -H "Authorization: Bearer YOUR_ID_TOKEN_HERE"

## Jobs (Protected - requires Bearer token)

## Jobs (Protected - requires Bearer token)

### Get all jobs
curl -X GET "http://localhost:3000/jobs" \
  -H "Authorization: Bearer YOUR_ID_TOKEN_HERE"

### Get specific job
curl -X GET "http://localhost:3000/jobs/job-id" \
  -H "Authorization: Bearer YOUR_ID_TOKEN_HERE"

### Create job
curl -X POST "http://localhost:3000/jobs" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_ID_TOKEN_HERE" \
  -d '{
    "title": "Build a React Dashboard",
    "description": "Need an experienced React developer to build an analytics dashboard.",
    "category": "Web Development",
    "tags": ["React", "JavaScript", "CSS"],
    "location_city": "Johannesburg",
    "location_country": "South Africa",
    "is_remote": true,
    "budget": 15000,
    "payment_type": "fixed",
    "currency": "ZAR",
    "status": "open",
    "slots": 1,
    "duration_days": 30,
    "start_date": "2026-06-01",
    "deadline": "2026-06-30"
  }'

### Update job
curl -X PUT "http://localhost:3000/jobs/job-id" \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer YOUR_ID_TOKEN_HERE" \
  -d '{
    "status": "in_progress",
    "budget": 16000,
    "slots": 2
  }'

### Delete job (soft delete)
curl -X DELETE "http://localhost:3000/jobs/job-id" \
  -H "Authorization: Bearer YOUR_ID_TOKEN_HERE"

